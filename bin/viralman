#!/usr/bin/env python3
"""viralman — typing the word starts the local dashboard and opens your browser.

Usage:
  viralman                # start dashboard at http://localhost:8765 + open browser
  viralman --port 9000
  viralman --no-browser
  viralman --host 0.0.0.0
  viralman --help

When invoked from inside the repo, it imports dashboard.server directly. When
installed via `pip install -e .`, the same package is available on the path.

If Flask is missing, it prints precise install instructions instead of crashing.
"""

from __future__ import annotations

import argparse
import os
import shutil
import sys
import threading
import time
import webbrowser
from pathlib import Path


def _ensure_repo_on_path() -> Path:
    """Make `import dashboard` work whether run from repo or from a global install."""
    here = Path(__file__).resolve()
    candidates = [here.parent.parent]  # repo root if bin/ is inside repo
    for d in candidates:
        if (d / "dashboard" / "server.py").exists():
            sys.path.insert(0, str(d))
            return d
    # If we're installed as a package, dashboard should already be importable.
    return here.parent


def _install_hint() -> str:
    py = sys.executable or "python3"
    venv_path = Path.cwd() / ".venv"
    return (
        "viralman dashboard needs Flask. Install it with one of:\n"
        f"  {py} -m pip install --user flask\n"
        f"  # or in a venv:\n"
        f"  python3 -m venv {venv_path} && {venv_path}/bin/pip install flask\n"
        f"  source {venv_path}/bin/activate && viralman\n"
        "Then re-run viralman."
    )


def _open_browser_when_ready(url: str, *, delay: float = 1.0) -> None:
    def _go() -> None:
        time.sleep(delay)
        try:
            webbrowser.open(url, new=2)
        except Exception:
            pass
    threading.Thread(target=_go, daemon=True).start()


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="viralman",
        description="Start the viralman dashboard (twitter / reddit / gitmail).",
    )
    p.add_argument("--host", default=os.environ.get("VIRALMAN_HOST", "127.0.0.1"))
    p.add_argument("--port", type=int,
                    default=int(os.environ.get("VIRALMAN_PORT", "8765")))
    p.add_argument("--no-browser", action="store_true",
                    help="Don't auto-open a browser tab.")
    p.add_argument("--debug", action="store_true",
                    help="Enable Flask debug reloader.")
    args = p.parse_args(argv)

    repo = _ensure_repo_on_path()

    try:
        from dashboard.server import create_app
    except SystemExit as e:
        # create_app raises SystemExit when Flask is missing; rewrite the message.
        sys.stderr.write(_install_hint() + "\n")
        return 2
    except ImportError as e:
        sys.stderr.write(f"viralman: import failed: {e}\n")
        sys.stderr.write(_install_hint() + "\n")
        return 2

    app = create_app()
    url = f"http://{args.host if args.host != '0.0.0.0' else 'localhost'}:{args.port}"
    print(f"viralman dashboard → {url}")
    print(f"  twitter:  {url}/twitter")
    print(f"  reddit:   {url}/reddit")
    print(f"  gitmail:  {url}/gitmail")
    print("Ctrl-C to stop.")

    if not args.no_browser:
        _open_browser_when_ready(url)

    try:
        app.run(host=args.host, port=args.port, debug=args.debug,
                 threaded=True, use_reloader=False)
    except OSError as e:
        if "Address already in use" in str(e):
            print(f"\nport {args.port} is in use. Try: viralman --port {args.port + 1}",
                   file=sys.stderr)
            return 2
        raise
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
